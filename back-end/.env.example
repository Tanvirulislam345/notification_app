# ───────── App ─────────
PORT=4000
NODE_ENV=development
# When true the process runs ONLY BullMQ workers (no HTTP server) — for horizontal scaling.
WORKER_ONLY=false

# ───────── Postgres ─────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=notif
DB_PASSWORD=notif
DB_NAME=notifications

# ───────── Redis (BullMQ + rate limiter + socket.io adapter) ─────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ───────── Email: Nodemailer (SMTP) — points at MailHog in dev ─────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Notifications <no-reply@example.com>"

# ───────── Email: SendGrid (optional primary provider) ─────────
# Leave empty to skip SendGrid and use Nodemailer/MailHog only.
SENDGRID_API_KEY=

# ───────── Worker concurrency (per process) ─────────
EMAIL_WORKER_CONCURRENCY=25
INAPP_WORKER_CONCURRENCY=50

# ───────── Rate limiting (Redis sliding window) ─────────
RATE_LIMIT_EMAIL_MAX=5
RATE_LIMIT_EMAIL_WINDOW_SEC=3600
RATE_LIMIT_INAPP_MAX=60
RATE_LIMIT_INAPP_WINDOW_SEC=3600

# ───────── Dev auth stub ─────────
DEV_USER_HEADER=x-user-id
